# Copy to `.env` and fill in the secrets. `.env` is gitignored.
# Anything already exported in your shell overrides what is set here.

# --- Required secrets ---------------------------------------------------
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
GLIDER_API_KEY=
GEMINI_API_KEY=

# --- Server -------------------------------------------------------------
STOCKFRONT_BIND_ADDRESS=127.0.0.1:3100

# --- Earn / carry policy ------------------------------------------------
# Reviewed investment IDs that may receive deposits. Empty closes the
# allowlist and nothing is depositable. This is the Lista USDT vault.
STOCKFRONT_CARRY_INVESTMENT_IDS=dfeb150e81cf3b1b5861b30db363ae824853a6fb3beb7fa4a83885dd0f414654
STOCKFRONT_MIN_CARRY_SPREAD_BPS=100

# --- Liquidity policy ---------------------------------------------------
STOCKFRONT_LIQUIDITY_INVESTMENT_IDS=72e73da9afc69f6b257f59eda4982815ca9c0ff6a0098267547c92e0c29f7761
STOCKFRONT_LIQUIDITY_SLIPPAGE_BPS=100

# --- Trading policy -----------------------------------------------------
# USDT, USDC on BNB Chain.
STOCKFRONT_TRADE_SETTLEMENT_TOKENS=0x55d398326f99059ff775485246999027b3197955,0x8ac76a51cc950d9822d68b83fe1ad97b32cd580d
STOCKFRONT_MAX_TRADE_PRICE_IMPACT_BPS=100
STOCKFRONT_TRADE_SLIPPAGE_BPS=50

# --- Borrowing (Venus) --------------------------------------------------
STOCKFRONT_BORROW_DEBT_TOKENS=0x55d398326f99059fF775485246999027B3197955
VENUS_COMPTROLLER_ADDRESS=0xfD36E2c2a6789Db23113685031d7F16329158384
VENUS_API_BASE_URL=https://api.venus.io
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# --- Provider base URLs -------------------------------------------------
BINANCE_WEB3_BASE_URL=https://web3.binance.com/build
RESERVE_API_BASE_URL=https://api.reserve.org
GLIDER_API_BASE_URL=https://api.glider.fi/v2
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-flash-latest

# --- Live integration tests (cargo test -- --ignored) -------------------
# These spend real funds. Rotate the key when testing is finished.
STOCKFRONT_E2E_PRIVATE_KEY=
STOCKFRONT_TEST_WALLET=0x4b393bEc5DeE11799F698440AB19c0FBfe15d74c
STOCKFRONT_E2E_CONFIRM=I_UNDERSTAND_THIS_SPENDS_REAL_FUNDS
STOCKFRONT_GLIDER_WITHDRAW_CONFIRM=I_UNDERSTAND_THIS_WITHDRAWS_REAL_FUNDS
STOCKFRONT_GLIDER_PORTFOLIO_ID=tvqolmgl

# --- AI strategy composer --------------------------------------------
# openrouter | gemini
AI_PROVIDER=openrouter
AI_REQUEST_TIMEOUT_SECONDS=60
# Must be a model that supports strict json_schema structured output.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
# Refuses providers that would silently drop the JSON schema. Leave false:
# true filters out every endpoint for most models (404 'Filter by Parameters').
OPENROUTER_REQUIRE_PARAMETERS=false
